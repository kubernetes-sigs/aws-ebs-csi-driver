# This script generates draft changelog entries for a new aws-ebs-csi-driver release:
# - Prepends driver release notes (generated by the kubernetes/release
#   release-notes tool from the release-note block of each merged PR) to
#   CHANGELOG.md
# - Prepends an entry with the released driver and sidecar versions to
#   charts/aws-ebs-csi-driver/CHANGELOG.md
#
# The generated entries are drafts: review and edit them (release summary,
# urgent upgrade notes, chart features) before submitting the release PR.

# --- Script Tools
set -euo pipefail

log() {
  printf "%s [INFO] - %s\n" "$(date +"%Y-%m-%d %H:%M:%S")" "${*}" >&2
}

check_dependencies() {
  local readonly dependencies=("yq" "grep")

  for cmd in "${dependencies[@]}"; do
    if ! command -v "${cmd}" &>/dev/null; then
      log "${cmd} could not be found, please install it."
      exit 1
    fi
  done

  if [[ ! -x "$RELEASE_NOTES_BIN" ]]; then
    log "release-notes could not be found at $RELEASE_NOTES_BIN, run 'make bin/release-notes' to install it."
    exit 1
  fi

  if [[ -z "${GITHUB_TOKEN:-}" ]]; then
    log "GITHUB_TOKEN must be set to a GitHub token with repo read access."
    exit 1
  fi
}

error_handler() {
  printf "Error occurred in script: %s, at line: %s. Command: %s. Error: %s\n" "$1" "$2" "$BASH_COMMAND" "$3" >&2
  exit 1
}

trap 'error_handler ${LINENO} $? "$BASH_COMMAND"' ERR

# --- Script
usage() {
  echo "Usage: $0 [PREV_DRIVER_VERSION] [NEW_DRIVER_VERSION]"
  echo "example: $0 v1.23.1 v1.24.0"
  exit 1
}

setup_vars() {
  export PREV_DRIVER_VERSION=$1
  export NEW_DRIVER_VERSION=$2

  export SCRIPT_PATH
  SCRIPT_PATH=$(dirname "$(realpath $0)")
  export ROOT_DIRECTORY="$SCRIPT_PATH/../.."
  export CHANGELOG_PATH="$ROOT_DIRECTORY/CHANGELOG.md"
  export CHART_CHANGELOG_PATH="$ROOT_DIRECTORY/charts/aws-ebs-csi-driver/CHANGELOG.md"
  export CHART_PATH="$ROOT_DIRECTORY/charts/aws-ebs-csi-driver/Chart.yaml"
  export VALUES_PATH="$ROOT_DIRECTORY/charts/aws-ebs-csi-driver/values.yaml"
  export RELEASE_NOTES_BIN="${RELEASE_NOTES_BIN:-$ROOT_DIRECTORY/bin/release-notes}"
}

parse_args() {
  [[ $# -ne 2 ]] && usage

  log "Confirming $1 < $2"
  sort -C -V <(
    echo "$1"
    echo "$2"
  ) || usage

  setup_vars "$@"
}

generate_driver_changelog() {
  log "Generating driver release notes for $PREV_DRIVER_VERSION..$NEW_DRIVER_VERSION"
  notes_file=$(mktemp)
  "$RELEASE_NOTES_BIN" \
    --org=kubernetes-sigs \
    --repo=aws-ebs-csi-driver \
    --required-author="" \
    --start-rev="$PREV_DRIVER_VERSION" \
    --end-rev="$NEW_DRIVER_VERSION" \
    --markdown-links \
    --output="$notes_file"

  log "Prepending draft release notes to CHANGELOG.md"
  new_changelog=$(mktemp)
  {
    echo "# $NEW_DRIVER_VERSION"
    echo ""
    cat "$notes_file"
    echo ""
    cat "$CHANGELOG_PATH"
  } >"$new_changelog"
  mv "$new_changelog" "$CHANGELOG_PATH"
  rm -f "$notes_file"
}

generate_chart_changelog() {
  chart_version=$(yq '.version' "$CHART_PATH")
  log "Prepending draft chart changelog entry for $chart_version"

  title_line=$(grep -n '^# Helm chart' "$CHART_CHANGELOG_PATH" | head -n 1 | cut -d: -f1)

  new_changelog=$(mktemp)
  {
    head -n "$title_line" "$CHART_CHANGELOG_PATH"
    echo ""
    echo "## $chart_version"
    echo "### Dependencies"
    echo " - Bumped EBS CSI Driver to \`$NEW_DRIVER_VERSION\`"
    yq '.sidecars | to_entries[] | select(.value.image != null) | .value.image.repository + " " + .value.image.tag' "$VALUES_PATH" |
      while read -r repository tag; do
        printf ' - Bumped `%s` to `%s`\n' "${repository##*/}" "$tag"
      done | LC_ALL=C sort
    tail -n "+$((title_line + 1))" "$CHART_CHANGELOG_PATH"
  } >"$new_changelog"
  mv "$new_changelog" "$CHART_CHANGELOG_PATH"
}

print_next_steps() {
  echo "SUCCESS!
Draft changelog entries were prepended to CHANGELOG.md and charts/aws-ebs-csi-driver/CHANGELOG.md.
Before you submit the release PR, review and edit them if applicable."
}

main() {
  parse_args "$@"
  check_dependencies

  generate_driver_changelog
  generate_chart_changelog
  print_next_steps
}

main "$@"
