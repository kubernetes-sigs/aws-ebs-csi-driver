set -euo pipefail

readonly SCRIPT_PATH="$(dirname "$(realpath "$0")")"
readonly ROOT_DIRECTORY="${SCRIPT_PATH}/../.."
readonly DOCKERFILE="${ROOT_DIRECTORY}/Dockerfile"

GO_VERSION="$(go -C "${ROOT_DIRECTORY}" list -m -f '{{.GoVersion}}')"

# Pin every base image to the current digest of its tag, moving the golang
# builder image to the go directive in go.mod
for PINNED in $(grep -oE '[^ ]+@sha256:[0-9a-f]+' "${DOCKERFILE}"); do
  IMAGE="${PINNED%@*}"
  if [[ "${IMAGE}" == */golang:* ]]; then
    IMAGE="${IMAGE%:*}:${GO_VERSION}"
  fi
  DIGEST="$(crane digest "${IMAGE}")"
  sed -i "s|${PINNED}|${IMAGE}@${DIGEST}|" "${DOCKERFILE}"
  echo "${IMAGE}@${DIGEST}"
done
